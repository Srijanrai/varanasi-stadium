# Public URL of the live site (used for canonical URLs, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://example.com
# Show draft listings locally / on preview deployments. Never set on production.
SHOW_DRAFTS=1
# Set to 1 only on preview/staging deployments: robots.txt then blocks all crawlers.
# PREVIEW_DEPLOYMENT=1
# Keeps Next.js from writing a telemetry ID to your home directory
NEXT_TELEMETRY_DISABLED=1
